# Neo4j container auth (used by Docker Compose)
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

# Application connection settings
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# LLM / MLLM -- endpoint Chat Completions OpenAI-compatible
# (OpenCode, Z.ai, vLLM self-host, dll). Satu client dipakai untuk
# ekstraksi citra (Modul A) dan reasoning/chat (Modul C).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Model multimodal untuk ekstraksi citra; kosongkan untuk memakai LLM_MODEL
MLLM_MODEL=
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1500
LLM_TIMEOUT_SECONDS=60
# Set false jika model tidak mendukung response_format json_object
LLM_JSON_MODE=true
