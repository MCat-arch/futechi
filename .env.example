# Satu file .env di ROOT repo, dipakai bersama oleh packages/pipeline & packages/api.

# --- Neo4j (knowledge graph) ---
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me
NEO4J_URI=bolt://localhost:7687
NEO4J_DATABASE=neo4j

# --- Neo4j KEDUA: graph data buku (ops/docker/docker-compose.neo4j-buku.yml) ---
NEO4J_BUKU_URI=bolt://localhost:7688
NEO4J_BUKU_USERNAME=neo4j
NEO4J_BUKU_PASSWORD=ganti-minimal-8-karakter
NEO4J_BUKU_DATABASE=neo4j

# --- LLM / MLLM: endpoint Chat Completions OpenAI-compatible ---
# (OpenRouter, OpenCode, Z.ai, vLLM self-host, dll). Satu client dipakai untuk
# ekstraksi citra (Modul A) dan reasoning/chat (Modul C).
# CATATAN: isi base URL sampai /v1 saja, JANGAN sampai /chat/completions.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Model multimodal untuk ekstraksi citra; kosongkan untuk memakai LLM_MODEL
MLLM_MODEL=
LLM_TEMPERATURE=0.0
# Reasoning model memakai sebagian token untuk "berpikir"; 1500 terbukti terpotong.
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=60
# Set false jika model tidak mendukung response_format json_object
LLM_JSON_MODE=true

# --- API: database & broker ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/futechi
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
IMAGE_STORAGE_DIR=./storage/crops
MAX_FRAMES_PER_CASE=5

# --- Kredensial container Postgres (dipakai docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=futechi

# --- Policy (nilai awal, perlu kalibrasi bersama pakar vet) ---
COOLDOWN_CYCLES=3
SAFETY_NET_ANOMALY_COUNT=3
CASE_TTL_HOURS=24
CAGE_HISTORY_LIMIT=5
CAGE_HISTORY_DAYS=90
